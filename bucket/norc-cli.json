{
    "version": "0.3.2",
    "description": "Headless cron job scheduler for norc — installs a per-user Scheduled Task (`norc bridge`) that syncs this machine's crontab with the norc web vault.",
    "homepage": "https://norc.app/cli",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://github.com/norcapp/norc-cli/releases/download/v0.3.2/norc-win-x64.exe#/norc.exe",
            "hash": "d3eae94fd7349f589cf73abaa96ce0341f2439375be5a7c694d527d6aa00d9b3"
        }
    },
    "bin": "norc.exe",
    "post_install": [
        "& \"$dir\\norc.exe\" service install",
        "& \"$dir\\norc.exe\" __dupe-check"
    ],
    "pre_uninstall": [
        "& \"$dir\\norc.exe\" service uninstall"
    ],
    "checkver": {
        "github": "https://github.com/norcapp/norc-cli",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/norcapp/norc-cli/releases/download/v$version/norc-win-x64.exe#/norc.exe"
            }
        }
    }
